---
import '../styles/global.css';
import { ColorSchemeScript } from '@mantine/core';

interface Props {
  title?: string;
}

const { title = "Kent Tsoi | Portfolio" } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ColorSchemeScript />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
